APP_NAME=RobotSys
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-robotsys-domain.example
TRUSTED_PROXIES=*

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_URL=

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

ROBOT_PUBLIC_STORAGE_PATH=/data/public
ESP32_CAMERA_SNAPSHOT_URL=
ESP32_CAMERA_STREAM_URL=
ROBOT_VISION_MODEL=efficientdet_lite2

RAILPACK_NODE_VERSION=22
RAILPACK_PHP_EXTENSIONS=gd,pdo_mysql
